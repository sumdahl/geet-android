[
  {
    "key": "output",
    "flag": "--output",
    "env": "GEET_OUTPUT",
    "type": "string",
    "default": "~/Music",
    "value": "/home/you/Music",
    "secret": false,
    "usage": "music library directory"
  },
  {
    "key": "output_template",
    "flag": "--output-template",
    "env": "GEET_OUTPUT_TEMPLATE",
    "type": "string",
    "default": "{title} - {artists}",
    "value": "{title} - {artists}",
    "secret": false,
    "usage": "file path under output, without extension; placeholders: {title} {artist} {artists} {album} {album_artist} {track} {disc} {year} {isrc} {spotify_id}"
  },
  {
    "key": "lyrics",
    "flag": "--lyrics",
    "env": "GEET_LYRICS",
    "type": "bool",
    "default": "true",
    "value": "true",
    "secret": false,
    "usage": "save each song's lyrics (synced when available, from LRCLIB) in its tags and a .lrc file next to it"
  },
  {
    "key": "playlist_folder",
    "flag": "--playlist-folder",
    "env": "GEET_PLAYLIST_FOLDER",
    "type": "bool",
    "default": "true",
    "value": "true",
    "secret": false,
    "usage": "put a playlist's tracks in a folder named after it, inside output"
  },
  {
    "key": "playlist_folder_case",
    "flag": "--playlist-folder-case",
    "env": "GEET_PLAYLIST_FOLDER_CASE",
    "type": "string",
    "default": "lower",
    "value": "lower",
    "secret": false,
    "usage": "playlist folder letter case: lower (road-trip-mix), capitalize (Road-trip-mix) or title (Road-Trip-Mix)",
    "choices": [
      "lower",
      "capitalize",
      "title"
    ]
  },
  {
    "key": "format",
    "flag": "--format",
    "env": "GEET_FORMAT",
    "type": "string",
    "default": "opus",
    "value": "opus",
    "secret": false,
    "usage": "audio format: opus, flac or mp3",
    "choices": [
      "opus",
      "flac",
      "mp3"
    ]
  },
  {
    "key": "bitrate",
    "flag": "--bitrate",
    "env": "GEET_BITRATE",
    "type": "string",
    "default": "",
    "value": "",
    "secret": false,
    "usage": "audio bitrate such as 320k; empty means best available"
  },
  {
    "key": "overwrite",
    "flag": "--overwrite",
    "env": "GEET_OVERWRITE",
    "type": "bool",
    "default": "false",
    "value": "false",
    "secret": false,
    "usage": "re-download tracks whose file already exists instead of skipping them"
  },
  {
    "key": "duplicates",
    "flag": "--duplicates",
    "env": "GEET_DUPLICATES",
    "type": "string",
    "default": "link",
    "value": "link",
    "secret": false,
    "usage": "a track already downloaded elsewhere (another playlist, or the same recording on another release): link (hard link, no extra space), copy, skip, or download again",
    "choices": [
      "link",
      "copy",
      "skip",
      "download"
    ]
  },
  {
    "key": "index_path",
    "flag": "--index-path",
    "env": "GEET_INDEX_PATH",
    "type": "string",
    "default": "",
    "value": "/home/you/.local/share/geet/index.json",
    "secret": false,
    "usage": "file remembering every downloaded track, for duplicates (default $XDG_DATA_HOME/geet/index.json)"
  },
  {
    "key": "progress",
    "flag": "--progress",
    "env": "GEET_PROGRESS",
    "type": "string",
    "default": "auto",
    "value": "auto",
    "secret": false,
    "usage": "animated progress bars: auto (only in a terminal, and not with --json), always or never",
    "choices": [
      "auto",
      "always",
      "never"
    ]
  },
  {
    "key": "download_retries",
    "flag": "--download-retries",
    "env": "GEET_DOWNLOAD_RETRIES",
    "type": "int",
    "default": "2",
    "value": "2",
    "secret": false,
    "usage": "extra attempts when a YouTube download fails (it is often a temporary 403 or throttling)"
  },
  {
    "key": "jobs",
    "flag": "--jobs",
    "env": "GEET_JOBS",
    "type": "int",
    "default": "4",
    "value": "4",
    "secret": false,
    "usage": "concurrent downloads"
  },
  {
    "key": "resolve_jobs",
    "flag": "--resolve-jobs",
    "env": "GEET_RESOLVE_JOBS",
    "type": "int",
    "default": "8",
    "value": "8",
    "secret": false,
    "usage": "songs read from Spotify and looked up on YouTube at once; higher reads big playlists faster but makes Spotify rate-limit sooner"
  },
  {
    "key": "spotify.client_id",
    "flag": "--spotify-client-id",
    "env": "GEET_SPOTIFY_CLIENT_ID",
    "type": "string",
    "default": "",
    "value": "",
    "secret": false,
    "usage": "Spotify Web API client ID (optional; needs Premium)"
  },
  {
    "key": "spotify.client_secret",
    "flag": "--spotify-client-secret",
    "env": "GEET_SPOTIFY_CLIENT_SECRET",
    "type": "string",
    "default": "",
    "value": "",
    "secret": true,
    "usage": "Spotify Web API client secret"
  },
  {
    "key": "spotify.cache_days",
    "flag": "--spotify-cache-days",
    "env": "GEET_SPOTIFY_CACHE_DAYS",
    "type": "int",
    "default": "30",
    "value": "30",
    "secret": false,
    "usage": "days to remember songs read from Spotify's public pages, so reading a playlist again skips them; 0 turns the cache off"
  },
  {
    "key": "youtube.search_query",
    "flag": "--youtube-search-query",
    "env": "GEET_YOUTUBE_SEARCH_QUERY",
    "type": "string",
    "default": "{artists} - {title}",
    "value": "{artists} - {title}",
    "secret": false,
    "usage": "YouTube search text; placeholders: {artists} {artist} {title} {album}"
  },
  {
    "key": "youtube.fallback_query",
    "flag": "--youtube-fallback-query",
    "env": "GEET_YOUTUBE_FALLBACK_QUERY",
    "type": "string",
    "default": "{artists} - {title} audio",
    "value": "{artists} - {title} audio",
    "secret": false,
    "usage": "second search when nothing from search_query matches (same placeholders); empty disables"
  },
  {
    "key": "youtube.search_results",
    "flag": "--youtube-search-results",
    "env": "GEET_YOUTUBE_SEARCH_RESULTS",
    "type": "int",
    "default": "5",
    "value": "5",
    "secret": false,
    "usage": "YouTube results to score per track"
  },
  {
    "key": "youtube.max_duration_diff",
    "flag": "--youtube-max-duration-diff",
    "env": "GEET_YOUTUBE_MAX_DURATION_DIFF",
    "type": "duration",
    "default": "10s",
    "value": "10s",
    "secret": false,
    "usage": "reject YouTube results whose length differs from Spotify's by more than this"
  },
  {
    "key": "youtube.cookies_file",
    "flag": "--youtube-cookies-file",
    "env": "GEET_YOUTUBE_COOKIES_FILE",
    "type": "string",
    "default": "",
    "value": "",
    "secret": false,
    "usage": "Netscape cookies file passed to yt-dlp"
  },
  {
    "key": "youtube.cookies_from_browser",
    "flag": "--youtube-cookies-from-browser",
    "env": "GEET_YOUTUBE_COOKIES_FROM_BROWSER",
    "type": "string",
    "default": "",
    "value": "",
    "secret": false,
    "usage": "send your YouTube sign-in from a browser, to get past \"confirm you're not a bot\": auto (the default browser), or brave, chromium, chrome, firefox, …; the keyring is added automatically. Off by default: YouTube then sees downloads as your account's"
  },
  {
    "key": "youtube.music_fallback",
    "flag": "--youtube-music-fallback",
    "env": "GEET_YOUTUBE_MUSIC_FALLBACK",
    "type": "bool",
    "default": "true",
    "value": "true",
    "secret": false,
    "usage": "when YouTube search finds no match, look for the song on YouTube Music, which lists official studio audio at the album's exact length (about 4s more for that song only)"
  },
  {
    "key": "youtube.title_fallback",
    "flag": "--youtube-title-fallback",
    "env": "GEET_YOUTUBE_TITLE_FALLBACK",
    "type": "bool",
    "default": "true",
    "value": "true",
    "secret": false,
    "usage": "last resort when nothing else matches: search by the song's title alone and accept only an upload with the full title within 2s of its length (for artists YouTube knows by another name); the song then carries a warning"
  },
  {
    "key": "youtube.extra_args",
    "flag": "--youtube-extra-args",
    "env": "GEET_YOUTUBE_EXTRA_ARGS",
    "type": "list",
    "default": "",
    "value": "",
    "secret": false,
    "usage": "extra yt-dlp arguments, space-separated"
  },
